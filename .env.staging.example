# Kuka i Motika: staging Firebase project (ocistimo-novi-sad-staging)
# Copy this file to ".env.staging.local" and fill in the values of the web app
# "Kuka i Motika (staging)" (Firebase console > project-7fe611ea-b32a-4a6e-85d >
# Project settings > Your apps). `npm run dev:staging` then runs against the
# staging database; it takes precedence over .env.local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=project-7fe611ea-b32a-4a6e-85d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-7fe611ea-b32a-4a6e-85d
VITE_FIREBASE_STORAGE_BUCKET=project-7fe611ea-b32a-4a6e-85d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Kuka i Motika: PRODUCTION Firebase project (ocistimo-novi-sad)
# Copy this file to ".env.production.local" and fill in the values. It is
# loaded only by `npm run dev:prod` and a local `npm run build`; plain
# `npm run dev` uses the staging project (.env.staging.local). Do not put
# these values in ".env.local": that file is loaded in every mode, staging too.
# All VITE_ variables are bundled into the public frontend build.
# Firebase web config is NOT a server secret; protection comes from
# Firestore Security Rules (see firestore.rules).

# Firebase web app configuration (Firebase console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
# Photos are stored in Cloud Storage for Firebase (needs the Blaze plan and
# the rules in storage.rules). Leave empty to run without photo uploads.
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Build
# Only needed for a project page build (GitHub Actions sets this automatically).
# Example: /ocistimo-novi-sad/. Leave empty for local development at "/".
VITE_BASE_PATH=

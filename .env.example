# Očistimo Novi Sad: environment variables
# Copy this file to ".env.local" and fill in your own values.
# All VITE_ variables are bundled into the public frontend build.
# Firebase web config is NOT a server secret; protection comes from
# Firestore Security Rules (see firestore.rules).

# Firebase web app configuration (Firebase console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Image uploads (optional)
# Firebase Storage requires the paid Blaze plan for new projects, so this app
# uses a modular adapter. Supported value: "cloudinary".
# Leave empty for "images disabled" mode: the site keeps working without photos.
VITE_IMAGE_PROVIDER=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=ns-cisto

# Build
# Only needed for a project page build (GitHub Actions sets this automatically).
# Example: /ocistimo-novi-sad/. Leave empty for local development at "/".
VITE_BASE_PATH=
